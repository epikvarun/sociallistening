# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# Twitter/X API v2 (required)
TWITTER_BEARER_TOKEN=AAAA...

# SerpAPI — optional, LinkedIn sweep skipped if empty
SERPAPI_KEY=

# Slack (required)
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_NAME=social-listening

# Agent behaviour
SEARCH_INTERVAL_MINUTES=60
DAILY_DIGEST_HOUR=9
DAILY_DIGEST_MINUTE=0
TIMEZONE=Asia/Kolkata
TWITTER_MAX_RESULTS=20
LINKEDIN_MAX_RESULTS=10
REDDIT_MAX_RESULTS=10
