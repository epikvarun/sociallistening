# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# Twitter/X API v2 (required)
TWITTER_BEARER_TOKEN=AAAA...

# SerpAPI — optional, LinkedIn sweep skipped if empty
SERPAPI_KEY=

# Slack — use webhook URL (preferred) or bot token fallback
# Get webhook: api.slack.com/apps → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_NAME=C099C1Z8PSP

# Agent behaviour — daily digest fires at DAILY_DIGEST_HOUR:00 IST
DAILY_DIGEST_HOUR=9
TWITTER_MAX_RESULTS=20
LINKEDIN_MAX_RESULTS=10

# Email — digest sent to EMAIL_TO after every run
EMAIL_SENDER=you@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_TO=varun@getepik.in
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
