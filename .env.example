# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# Twitter/X API v2 (required)
TWITTER_BEARER_TOKEN=AAAA...

# SerpAPI — optional, LinkedIn sweep skipped if empty
SERPAPI_KEY=

# Slack (required) — get webhook URL from api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Agent behaviour
SEARCH_INTERVAL_MINUTES=60
TWITTER_MAX_RESULTS=20
LINKEDIN_MAX_RESULTS=10

# Debug mode — set to 1 to see full API responses for troubleshooting
DEBUG_MODE=0
